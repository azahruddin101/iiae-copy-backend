# Existing application settings
PORT=
MONGO_URI=
JWT_SECRET=
NODE_ENV=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Meta (Facebook) Lead Ads integration
#
# NOTHING below is required. The Meta app (App ID + App Secret) is entered by an
# admin in the CRM under Integrations > Meta Lead Ads and stored encrypted in the
# database. Set these only if you prefer to fix the Meta app in the server
# environment - values set here take precedence over what is saved in the CRM.
# ---------------------------------------------------------------------------

# Meta Developer App credentials (App Dashboard > App settings > Basic)
META_APP_ID=
META_APP_SECRET=

# Must exactly match a "Valid OAuth Redirect URI" in the Meta app, e.g.
# https://api.your-domain.com/api/integrations/meta/callback
META_REDIRECT_URI=

# Any long random string - entered again as the "Verify token" of the Meta webhook
META_WEBHOOK_VERIFY_TOKEN=

# Secret used to verify webhook signatures. Defaults to the App Secret
META_WEBHOOK_APP_SECRET=

# Graph API version. Defaults to v26.0
META_GRAPH_API_VERSION=

# 32-byte key (64 hex characters) used to encrypt stored Meta secrets.
# When empty, a key derived from JWT_SECRET is used instead.
# Changing this key or JWT_SECRET later means the Meta app has to be entered and connected again.
META_TOKEN_ENCRYPTION_KEY=

# CRM page the browser returns to after Facebook Login, e.g.
# https://crm.your-domain.com/dashboard/integrations/meta
META_FRONTEND_REDIRECT_URL=
